@page
@model IndexModel
@using SecuritySample.Models
@using SecuritySample.Services
@{
    ViewData["Title"] = "Security Monitoring Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Security Monitoring Dashboard</h1>
    <span class="text-muted small">Sample data &middot; last 48 hours</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center h-100">
            <div class="card-body">
                <div class="display-6">@Model.TotalEvents</div>
                <div class="text-muted">Total Events</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100 border-danger">
            <div class="card-body">
                <div class="display-6 text-danger">@Model.AnomalyCount</div>
                <div class="text-muted">Flagged Anomalies</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100 border-warning">
            <div class="card-body">
                <div class="display-6 text-warning">@Model.AtRiskCount</div>
                <div class="text-muted">SLA At Risk</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center h-100 border-danger">
            <div class="card-body">
                <div class="display-6 text-danger">@Model.BreachedCount</div>
                <div class="text-muted">SLA Breached</div>
            </div>
        </div>
    </div>
</div>

<h2 class="h5 mb-3">SLA Rules by Severity</h2>
<table class="table table-sm table-bordered mb-4">
    <thead>
        <tr>
            <th>Severity</th>
            <th>Response Time</th>
            <th>Resolution Time</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rule in Model.SlaRules.Values.OrderBy(r => r.Severity))
        {
            <tr>
                <td>@rule.Severity</td>
                <td>@rule.ResponseTimeMinutes min</td>
                <td>@rule.ResolutionTimeMinutes min</td>
            </tr>
        }
    </tbody>
</table>

<h2 class="h5 mb-3">Events</h2>
<div class="table-responsive">
<table class="table table-sm table-hover align-middle">
    <thead>
        <tr>
            <th>Time (UTC)</th>
            <th>Source IP</th>
            <th>Type</th>
            <th>Severity</th>
            <th>Status</th>
            <th>SLA</th>
            <th>Anomaly</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model.Events)
        {
            var slaStatus = Model.Detector.GetSlaStatus(e);
            var rowClass = e.IsAnomaly ? "table-danger" : (slaStatus == SlaStatus.Breached ? "table-warning" : "");
            <tr class="@rowClass">
                <td class="text-nowrap">@e.Timestamp.ToString("MM-dd HH:mm")</td>
                <td>@e.SourceIp</td>
                <td>@e.EventType</td>
                <td>
                    <span class="badge @SeverityBadgeClass(e.Severity)">@e.Severity</span>
                </td>
                <td>@e.Status</td>
                <td>
                    <span class="badge @SlaBadgeClass(slaStatus)">@slaStatus</span>
                </td>
                <td>
                    @if (e.IsAnomaly)
                    {
                        <span class="badge bg-dark">⚠ z=@e.AnomalyScore</span>
                    }
                </td>
                <td class="small">@e.Description</td>
            </tr>
        }
    </tbody>
</table>
</div>

@functions {
    string SeverityBadgeClass(Severity s) => s switch
    {
        Severity.Critical => "bg-danger",
        Severity.High => "bg-warning text-dark",
        Severity.Medium => "bg-info text-dark",
        _ => "bg-secondary"
    };

    string SlaBadgeClass(SlaStatus s) => s switch
    {
        SlaStatus.Breached => "bg-danger",
        SlaStatus.AtRisk => "bg-warning text-dark",
        _ => "bg-success"
    };
}
